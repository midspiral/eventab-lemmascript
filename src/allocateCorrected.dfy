method allocate(total: int, weights: seq<int>) returns (res: seq<int>)
  requires (total >= 0)
  requires (|weights| >= 1)
  requires forall k: int :: ((0 <= k) ==> (k < |weights|) ==> (weights[k] >= 0))
  requires (sum(weights) >= 1)
  ensures (sum(res) == total)
{
  var i_t0 := sum(weights);
  var W := i_t0;
  var result := seq(|weights|, i_map requires 0 <= i_map < |weights| => var w := weights[i_map]; JSFloorDiv((total * w), W));
  FloorDeficitBound(result, total, weights, W);
  var i_t1 := sum(result);
  var left := (total - i_t1);
  var k := 0;
  while (k < left)
    invariant |result| == |weights|
    invariant 0 <= k <= left
    invariant left < |weights|
    invariant sum(result) + left - k == total
    decreases left - k
  {
    SumToUpdate(result, k, |result|, 1);
    result := result[k := (result[k] + 1)];
    k := (k + 1);
  }
  return result;
}
