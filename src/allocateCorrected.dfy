}

// With n weights, the floored shares leave at most n - 1 units.
lemma DeficitCancel(total: int, placed: int, n: int, W: int)
  requires n >= 1 && W >= 1
  requires total * W <= placed * W + n * (W - 1)
  ensures total <= placed + n - 1
{
