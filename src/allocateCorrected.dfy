import opened Std.Arithmetic.Mul

function JSFloorDiv(a: int, b: int): int
  requires b != 0
{
  if b > 0 then
    if a >= 0 then a / b
    else -((-a - 1) / b) - 1
  else
    if a <= 0 then (-a) / (-b)
    else -((a - 1) / (-b)) - 1
}

function sumTo(arr: seq<int>, n: int): int
  requires (0 <= n)
  requires (n <= |arr|)
  decreases n
{
  if (n == 0) then
    0
  else
    (sumTo(arr, (n - 1)) + arr[(n - 1)])
}

function sum(arr: seq<int>): int
{
  sumTo(arr, |arr|)
}

// The same prefix/update facts used by allocate.ts.
lemma SumToSamePrefix(a: seq<int>, b: seq<int>, n: int)
  requires 0 <= n <= |a|
  requires n <= |b|
  requires forall k :: 0 <= k < n ==> a[k] == b[k]
  ensures sumTo(a, n) == sumTo(b, n)
  decreases n
{
  if n != 0 {
    SumToSamePrefix(a, b, n - 1);
  }
}

lemma SumToUpdate(arr: seq<int>, j: int, n: int, d: int)
  requires 0 <= j < n <= |arr|
  ensures sumTo(arr[j := arr[j] + d], n) == sumTo(arr, n) + d
  decreases n
{
  if j == n - 1 {
    SumToSamePrefix(arr, arr[j := arr[j] + d], n - 1);
  } else {
    SumToUpdate(arr, j, n - 1, d);
  }
}

