lemma FloorDeficitBound(result: seq<int>, total: int, weights: seq<int>, W: int)
  requires |result| == |weights| >= 1
  requires total >= 0 && W >= 1
  requires W == sum(weights)
  requires forall k :: 0 <= k < |weights| ==> weights[k] >= 0
  requires forall k :: 0 <= k < |weights| ==> result[k] == JSFloorDiv(total * weights[k], W)
  ensures 0 <= total - sum(result) < |weights|
{
