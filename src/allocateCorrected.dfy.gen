function JSFloorDiv(a: int, b: int): int
  requires b != 0
{
  if b > 0 then
    if a >= 0 then a / b
    else -((-a - 1) / b) - 1
  else
    if a <= 0 then (-a) / (-b)
    else -((a - 1) / (-b)) - 1
}

function sumTo(arr: seq<int>, n: int): int
  requires (0 <= n)
  requires (n <= |arr|)
  decreases n
{
  if (n == 0) then
    0
  else
    (sumTo(arr, (n - 1)) + arr[(n - 1)])
}

function sum(arr: seq<int>): int
{
  sumTo(arr, |arr|)
}

method allocate(total: int, weights: seq<int>) returns (res: seq<int>)
  requires (total >= 0)
  requires (|weights| >= 1)
  requires forall k: int :: ((0 <= k) ==> (k < |weights|) ==> (weights[k] >= 0))
  requires (sum(weights) >= 1)
  ensures (sum(res) == total)
{
  var i_t0 := sum(weights);
  var W := i_t0;
  var result := seq(|weights|, i_map requires 0 <= i_map < |weights| => var w := weights[i_map]; JSFloorDiv((total * w), W));
  var i_t1 := sum(result);
  var left := (total - i_t1);
  var k := 0;
  while (k < left)
  {
    result := result[k := (result[k] + 1)];
    k := (k + 1);
  }
  return result;
}
